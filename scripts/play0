#!/bin/sh
# configures site 0 distributor.
# usage: play0 site1[,site2,..]

spad2nchan() {
	mode=$1
	nwords=$2
	case $mode in
	0)
		echo 0;;
	1)
		echo $nwords;;
	2)
		echo 1;;
	esac
}

if [ "x$1" = "x" ]; then
	source /etc/sites
	sitelist=$sites
	echo using default sitelist $sitelist
	pad=${pad:-0}
else
	sitelist=$1
	pad=${2:-0}
	shift; shift
fi
sites="$(echo $sitelist | tr , \ )"

echo sitelist: $sitelist
echo sites: $sites

DK=/dev/acq400.0.knobs
EK=/etc/acq400/0

nspad=$pad
source get_site_total_size
echo $SSB > ${EK}/dssb

# normally set by run0, but if no agg sites, set them from here..
[ -f ${EK}/sites ] || set.sys ${EK}/sites ${sitelist}
set.sys ${DK}/distributor 0
set.sys ${DK}/data_engine_1 0
set.sys ${DK}/data_engine_1 distributor=1

extra_args=${*:-on}
set.sys ${DK}/distributor threshold=16384 pad=${pad} sites=${sitelist} $extra_args
echo distributor set $(get.sys ${DK}/distributor)
echo dist_s1     set $(get.sys ${DK}/dist_s1)
echo $sites > /etc/acq400/0/play0_ready
echo $0 $* ssb=$SSB > /var/log/play0.log




