#!/bin/sh
source /etc/profile

show() {
	echo -----------------------------------------------------------------------------------------
        echo diagsdump:file $1

}
showcat() {
	show $1
        cat $1
}

echo $(hostname) $(date)
showcat /mnt/VERSION
showcat /tmp/fpga_status
show dmesg; dmesg
show logread; logread
for file in /dev/shm/*.xml; do
	show $file
	sed -e s'/<v><!\[CDATA\[/\n/' -e s'/\]\]>.*<\/v>//' $file
done
show /var/log/epics.log; nbcat /var/log/epics.log


