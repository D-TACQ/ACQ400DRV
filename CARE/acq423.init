#!/bin/sh

if [ -e /dev/shm/is_d37 ]; then
        echo +++ set d37 mode for sites $*
	for site in $*
	do
		set.sys /dev/acq400.$site.knobs/d37_mode 1
	done
fi


# FPGA check for XRM
FPGA=$(grep filename /tmp/fpga_status | awk '{ print $5 }')

if echo $FPGA | grep -q '\-XRM'; then
    echo "It's an XRM!"
fi
