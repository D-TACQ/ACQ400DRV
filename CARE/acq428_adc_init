#!/usr/bin/python

import sys
import spidev

# ---------------------------------------------------------
# Argument Parsing
# ---------------------------------------------------------
try:
    DEVICE_NUMBER = int(sys.argv[1])
    ADC_MODEL = sys.argv[2].upper()
    if ADC_MODEL not in ["5M", "10M"]:
        raise ValueError
except:
    print(f"Usage: {sys.argv[0]} <device_number> <5M | 10M>")
    print("Example: ./acq428_adc_init 16 5M")
    sys.exit(1)

# ---------------------------------------------------------
# SPI Setup
# ---------------------------------------------------------
spi = spidev.SpiDev()
spi.open(1, DEVICE_NUMBER)
spi.max_speed_hz = 10000000
spi.mode = 0b00

# ---------------------------------------------------------
# Daisy Chain Chip Init
# ---------------------------------------------------------
# 0x1C writes 7 into bits 2-6 of register 0x01
s = [0x01, 0x00, 0x1C]
z = [0x00, 0x00, 0x00]

f1 = z+z+z+z+z+z+z+s
f2 = z+z+z+z+z+z+s+s
f3 = z+z+z+z+z+s+s+s
f4 = z+z+z+z+s+s+s+s
f5 = z+z+z+s+s+s+s+s
f6 = z+z+s+s+s+s+s+s
f7 = z+s+s+s+s+s+s+s
f8 = s+s+s+s+s+s+s+s

chain24 = [f1,f2,f3,f4,f5,f6,f7,f8]

responses = []
for frame in chain24:
    responses.append(spi.xfer3(frame))

for response in responses:
    resp = map(hex, response)
    #print(list(resp))

# ---------------------------------------------------------
# ADC Register Write Helper
# ---------------------------------------------------------
def register_write(addr, data, dev=None):
    data_high_byte = data >> 8
    data_low_byte = data & 255
    s = [addr, data_high_byte, data_low_byte]
    chain = s+s+s+s+s+s+s+s

    if not dev:
        response = spi.xfer3(chain)
    else:
        response = dev.xfer3(chain)
    return response

# ---------------------------------------------------------
# ADC Initialization Sequences
# ---------------------------------------------------------
adc_sequences = {
    "10M": [
        # 10MSPS Sequence (Initial debug configuration) ADS92X8
        # Addr, Data 
        (0x12, 0x0007), # DATA_LANES (bits 2-0 = 111) 
        (0xC0, 0x0000), # CLK1 (bit 12 = 0)
        (0xC1, 0x0000), # CLK2 (bit 0 = 0), DATA_RATE (bit 8 = 0)
        (0xC5, 0x0000), # CLK3 (bit 0 = 0), CLK4 (bits 3-2 = 00)
        (0xFB, 0x0002), # CLK5 (bit 1 = 1) -> 0x1 << 1 = 0x02
        (0x1C, 0x0000), # CLK6 (bits 7-6 = 00)
        (0x0D, 0x2042), # Put OSR on
    ],
    "5M": [
        # 5MSPS Sequence ADS92X7
        # Addr, Data
        (0x04, 0x000B), # INIT_1 (bits 3-0 = B) -> Enter Init Mode
        (0x12, 0x0007), # DATA_LANES (bits 2-0 = 111)
        (0xC0, 0x1000), # CLK1 (bit 12 = 1) -> 0x1 << 12 = 0x1000
        (0xC1, 0x0000), # CLK2 (bit 0 = 0), DATA_RATE (bit 8 = 0)
        (0xC5, 0x020C), # CLK3 (bit 9 = 1), CLK4 (bits 3-2 = 11) -> 0x020C
        (0xFB, 0x0000), # CLK5 (bit 1 = 0)
        (0x03, 0x0010), # Bank select switch to bank 2
        (0x1C, 0x00C0), # CLK6 (bits 7-6 = 11) -> 0x3 << 6 = 0x00C0
        (0x03, 0x0002), # Bank select switch to bank 1
        (0x04, 0x0000), # INIT_1 (bits 3-0 = 0) -> Exit Init Mode
        (0x0D, 0x2002), # Make sure OSR is off...
    ]
}

# ---------------------------------------------------------
# Execute Selected Sequence
# ---------------------------------------------------------
print(f"Executing SPI configuration sequence for {ADC_MODEL}...")

active_sequence = adc_sequences[ADC_MODEL]
adc_responses = []

for reg_addr, reg_data in active_sequence:
    adc_responses.append(register_write(reg_addr, reg_data))

for response in adc_responses:
    resp = map(hex, response)
    #print(list(resp)[24:])

print("Sequence execution complete.")
