#!/bin/sh
# acq428_train_monitor
# Usage: ./acq428_train_monitor <site_number>

SITE=${1:-1}
LOG="logger -t acq428_monitor"
POLL_INTERVAL=3000000 # Adjust based on how fast a reaction required

TRAIN_BIT_REG="frame_ok" 

do_retrain() {
    $LOG "site:$SITE - $TRAIN_BIT_REG dropped LOW. Initiating retrain sequence."
    
    # Set a busy flag so other processes know training is active
    # This flag still needs to be implemented
    # set.site $SITE SIG:CLK:TRAIN_BSY 1

    # Execute training routine. 
    /usr/local/CARE/acq428_retrain $SITE | $LOG
    
    # If acq428_train is asynchronous, add a wait loop here 
    # similar to wait_training_done() in acq480_streamd.0.conf.

    # set.site $SITE SIG:CLK:TRAIN_BSY 0
    $LOG "site:$SITE - Retrain sequence complete."
}

$LOG "Starting monitor for site:$SITE on register:$TRAIN_BIT_REG"

while true; do
    # if running a shot do nothing
    CURRENT_STATE=$((get.site 0 state))
    if [ "$CURRENT_STATE" = "0 0 0 0 0" ]; then

	# Read the current status of the bit
	# Assuming get.site returns '1' for OK and '0' for loss of training
	CURRENT_FRAME_STATUS=$(get.site $SITE $TRAIN_BIT_REG)

	if [ "$CURRENT_FRAME_STATUS" = "0" ]; then
	    do_retrain
	    echo "acq428 in site ${SITE} retraining" > /dev/kmsg
	    # Give the hardware a moment to settle before resuming polling
	    sleep 2
	fi
    fi

    usleep $POLL_INTERVAL
done

